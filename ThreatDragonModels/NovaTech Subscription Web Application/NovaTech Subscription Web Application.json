            "id": "f64212d8-83b8-42aa-ba81-fc387c865c21",
            "data": {
              "type": "tm.Process",
              "name": "Web Server",
              "description": "Processes user registration, authentication, subscription requests, and communication with the SQL database and external payment gateway.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "c9012453-6ad9-41fc-8be4-04c3e73b5b0a",
                  "title": "Web Server Impersonation",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker could impersonate the legitimate NovaTech web server through DNS spoofing or a compromised digital certificate. Users may unknowingly connect to a fraudulent server and disclose their login credentials and personal information. ",
                  "mitigation": "Implement HTTPS with valid TLS certificates, enforce certificate validation, enable HSTS, and use secure DNS configurations. Regularly monitor certificates and DNS records to detect unauthorized changes.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "3161f099-4049-4d16-a28c-e688dcf7ae73",
                  "title": "Unauthorized Modification of Account Data",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker could exploit vulnerabilities in the web application to modify user account information or subscription records without authorization. This could result in altered account details, unauthorized subscription changes, or fraudulent transactions.",
                  "mitigation": "Implement strict input validation, parameterized SQL queries, and server-side authorization checks. Apply role-based access controls and audit logging to detect unauthorized modifications. Use secure session management and protect sensitive operations against cross-site request forgery (CSRF).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "4551f3b2-e4a1-46c9-8641-dd0d5a477921",
                  "title": "Denial of Subscription Transactions",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "A user could deny having purchased a subscription or performed an account-related transaction. If the application does not maintain reliable records of user activities and payment transactions, NovaTech may be unable to verify whether the transaction occurred or identify the responsible user.",
                  "mitigation": "Implement secure audit logging to record user authentication events, subscription purchases, and account changes. Include timestamps, user identifiers, transaction IDs, and payment confirmation records. Protect logs against unauthorized modification and restrict access to authorized personnel.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "72c505f6-159b-4fc4-b656-205074e3a233",
                  "title": "Exposure of Sensitive User Information",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "An attacker could exploit vulnerabilities in the web application to gain unauthorized access to sensitive user information, including personal details, login credentials, and subscription records. This could result in a data breach, identity theft, or unauthorized disclosure of confidential customer information.",
                  "mitigation": "Encrypt sensitive information both in transit and at rest. Implement strong authentication, role-based access controls, and least-privilege permissions. Use secure session management, regularly patch application vulnerabilities, and conduct security testing to identify potential data exposure risks.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "b672d500-5f68-40c5-8113-3496374b3ccc",
                  "title": "Web Server Service Disruption",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "An attacker could overwhelm the NovaTech web server with excessive requests or malicious traffic, causing the application to become slow or unavailable. This could prevent legitimate users from registering accounts, logging in, or purchasing subscriptions.",
                  "mitigation": "Implement rate limiting, request throttling, and traffic monitoring to detect abnormal activity. Use a Web Application Firewall (WAF), DDoS protection services, and load balancing to distribute traffic. Establish server resource limits and availability monitoring to maintain service reliability.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "b0d85c0e-09d0-47aa-b49e-20fe1c2c904c",
                  "title": "Unauthorized Administrative Access",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "An attacker could exploit weaknesses in the web application's authorization mechanisms to gain elevated privileges or unauthorized administrative access. This could allow the attacker to access restricted user information, modify subscription records, or perform administrative actions without proper authorization.",
                  "mitigation": "Implement role-based access control (RBAC), enforce server-side authorization checks for all sensitive operations, and follow the principle of least privilege. Regularly review user permissions and conduct security testing to identify privilege escalation vulnerabilities.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 2,
                "tampering": 1,
                "repudiation": 1,
                "informationDisclosure": 1,
                "denialOfService": 1,
                "elevationOfPrivilege": 1
              }
            }
