  "summary": {
    "title": "NovaTech Subscription Web Application",
    "owner": "Grace Sjoquist",
    "description": "The NovaTech web application allows users to create accounts and purchase paid subscriptions. The system consists of a web server that processes user requests, a SQL database that stores account and subscription information, and an external payment gateway that processes transactions and returns payment status information. The application includes internet-facing and internal trust boundaries. This threat model identifies potential security threats using the STRIDE methodology.",
    "id": 0
  },
