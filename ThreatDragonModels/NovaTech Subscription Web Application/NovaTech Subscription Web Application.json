            "data": {
              "type": "tm.Actor",
              "name": "Payment Gateway",
              "description": "External third-party payment service that processes subscription transactions and returns payment status information.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "3b80c271-7c54-4b12-8d0d-f762ff40a1b1",
                  "title": "Fraudulent Payment Requests",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker could impersonate the Web Server or submit fraudulent payment requests to the Payment Gateway, potentially resulting in unauthorized transactions.",
                  "mitigation": "Implement strong API authentication, secure API keys, and verify the identity and authorization of all incoming payment requests.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                },
                {
                  "id": "088ddbf0-dc54-4f88-a66b-8cd9ed84f95e",
                  "title": "Payment Transaction Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "A user could deny initiating a payment transaction or an attacker could dispute whether a payment was successfully processed due to insufficient transaction records.",
                  "mitigation": "Maintain secure transaction logs containing timestamps, transaction IDs, payment amounts, and user identifiers. Use digital signatures and retain payment confirmations.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "repudiation": 1
              }
            }
