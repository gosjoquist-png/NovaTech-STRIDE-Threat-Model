            "id": "8628a3df-4e04-448d-99a7-4be3813e2006",
            "data": {
              "type": "tm.Store",
              "name": "SQL Database",
              "description": "Stores user account information, authentication data, and subscription records.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": false,
              "storesInventory": false,
              "threats": [
                {
                  "id": "6c256fd0-9c9a-4c97-a8d2-aca7a4ff57f1",
                  "title": "Unauthorized Database Access",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "Information disclosure",
                  "description": "An attacker could exploit database vulnerabilities or weak access controls to gain unauthorized access to the SQL database. This could expose sensitive customer information, login credentials, and subscription records.",
                  "mitigation": "Implement role-based access controls, enforce least-privilege permissions, encrypt sensitive data at rest, and require strong authentication for database access.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "e68b99e6-e9dc-4ed9-a6a4-34f523781b1f",
                  "title": "Unauthorized Modification of Database Records",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker could exploit SQL injection vulnerabilities or compromised database credentials to modify, delete, or manipulate stored user account and subscription information.",
                  "mitigation": "Use parameterized SQL queries, validate database inputs, enforce strict database permissions, and maintain regular backups to restore modified or deleted information.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "648aae56-40a5-4e5b-8b9c-92ef802b4444",
                  "title": "Database Service Disruption",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "An attacker could overwhelm the SQL database with excessive queries or malicious requests, consuming available resources and preventing the application from retrieving or storing information.",
                  "mitigation": "Implement database resource limits, query timeouts, connection limits, traffic monitoring, and regular database performance maintenance.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                },
                {
                  "id": "1801af75-4ba8-4d7d-a4b9-d25562cb38ab",
                  "title": "Repudiation of Database Changes",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "An attacker or authorized user could modify or delete database records and deny having performed the action if adequate audit logging is not implemented.",
                  "mitigation": "Implement comprehensive database audit logging, record user identities and timestamps for all database changes, protect logs from unauthorized modification, and regularly review audit trails.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "tampering": 1,
                "repudiation": 1,
                "informationDisclosure": 1,
                "denialOfService": 1
              }
            }
